# 운영 .env 틀 — deploy.sh 가 설치할 때 이 파일에서 만든다.
#
# **REPLACE_ 자리는 deploy.sh 가 난수로 채운다.** 손으로 만들 때는 직접 넣는다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# **BOM 없이 UTF-8 로 저장한다.** BOM 이 붙으면 첫 줄 키만 조용히 무시되고,
# APP_ENV 가 기본값으로 떨어져 운영이 development 로 뜬다.

# --- 앱 ---
APP_ENV=production
# 포트는 플랫폼마다 10씩 벌린다. Apptainer 는 호스트 네트워크라 이 값이 곧
# 호스트의 포트다 — 겹치면 나중에 뜬 쪽이 그냥 못 뜬다.
PORT=8030
HOST=0.0.0.0
UVICORN_WORKERS=4

# --- 보안 ---
# 기본값이면 앱이 기동을 거부한다(app/main.py). 그것이 의도다.
JWT_SECRET=REPLACE_WITH_RANDOM_48_CHAR_SECRET
# https 로 서비스하면 true 로 올린다. (true 인데 http 로 접속하면 브라우저가
# 쿠키를 버려 로그인이 유지되지 않는다)
REFRESH_COOKIE_SECURE=false

# --- 데이터베이스 ---
# Apptainer 가 호스트 네트워크를 쓰므로 localhost 가 그대로 통한다.
DATABASE_URL=postgresql+psycopg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:5432/REPLACE_DB_NAME

# --- 컨테이너 안의 경로 ---
#
# **여기 안 적어도 된다.** 이미지가 자기 배치를 알고 있어서(apptainer.def 의
# %environment) LOG_DIR·FILESTORE_DIR 은 /data/logs · /data/filestore 로 온다.
#
# 적어서 바꾸려면 **systemd 유닛의 --bind 대상도 함께** 바꿔야 한다. 한쪽만
# 바꾸면 앱이 마운트 안 된 경로에 쓰게 되고, 기동 가드가 그것을 잡아 준다
# (무엇을 고쳐야 하는지 함께 말한다).
# LOG_DIR=/data/logs
# FILESTORE_DIR=/data/filestore

# --- 백업 ---
# **호스트 경로다**(컨테이너 안이 아니다). 앱은 이 폴더의 마지막 덤프 시각만
# 읽어 홈의 「남은 일」 에 올린다 — 그러려면 읽을 수 있게 마운트하거나,
# 백업을 설치 폴더 아래에 두어야 한다. 안 적으면 「설정이 없다」 로 뜬다.
# BACKUP_DIR=/home/<operator>/backup/<slug>

# --- CORS ---
# 배포는 백엔드 한 프로세스가 SPA 까지 서빙하므로 같은 출처다 — 보통 비운다.
# CORS_ORIGINS=["https://app.example.com"]
