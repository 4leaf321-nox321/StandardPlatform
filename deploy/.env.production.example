# 운영 .env 틀 — deploy.sh 가 설치할 때 이 파일에서 만든다.
#
# **REPLACE_ 자리는 deploy.sh 가 난수로 채운다.** 손으로 만들 때는 직접 넣는다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# **BOM 없이 UTF-8 로 저장한다.** BOM 이 붙으면 첫 줄 키만 조용히 무시되고,
# APP_ENV 가 기본값으로 떨어져 운영이 development 로 뜬다.

# --- 앱 ---
APP_ENV=production
# **이 설치가 무슨 플랫폼인가.** 번들 하나로 여러 플랫폼을 띄운다 — deploy.sh 가 채운다.
# APP_SLUG 는 소문자·숫자 한 덩어리(32자 이내). DB · 쿠키 · 토큰 · 유닛 이름이 여기서 나오므로
# **설치 뒤에는 바꾸지 않는다.** 이름 · 설명 · 확장은 바꿔도 된다(재시작).
APP_SLUG=REPLACE_APP_SLUG
APP_NAME=REPLACE_APP_NAME
APP_TAGLINE=
# 켤 확장 모듈, 쉼표로(app/extensions/<이름>). 비우면 코어만.
EXTENSIONS=
# 포트는 플랫폼마다 10씩 벌린다. Apptainer 는 호스트 네트워크라 이 값이 곧
# 호스트의 포트다 — 겹치면 나중에 뜬 쪽이 그냥 못 뜬다.
PORT=8040
HOST=0.0.0.0
UVICORN_WORKERS=4

# --- 작업 워커 (<slug>-worker) ---
# 파일 가져오기 · 내보내기 · 묶음 · 데이터 소스 동기화가 여기서 돈다. 기본값으로 충분하므로
# **안 적어도 된다** — 큰 파일을 받아야 할 때만 상한을 올린다.
#
# 올린 파일은 작은 것은 DB(job_files)에, 큰 것(아래 문턱 초과)은 FILESTORE_DIR/_jobs/ 에 든다 —
# 서버 두 대가 같이 읽어야 해서다(이중화면 FILESTORE_DIR 이 공용 폴더). 7일 뒤 지운다(백업 덤프에는
# 내용이 안 담긴다).
# 첨부 한 파일의 상한(500MB) — 객체 첨부 · 게시판 · 사진 한 장 · MCP 업로드. 넘으면 받기 전에 413.
# 이중화 nginx 의 client_max_body_size 512m 를 넘겨 올리면 그 조각도 함께 올린다.
# ATTACHMENT_MAX_BYTES=524288000
# 표 파일(일괄 입력 CSV · 묶음)의 상한 — 처리가 통째로 메모리에 올려 푼다.
# JOB_FILE_MAX_BYTES=104857600
# 사진 일괄 업로드 zip 의 상한(2GB) — 흘려 받고 파일로 열어 한 장씩 읽는다. 올리면 이중화
# nginx 조각의 사진 zip 경로(client_max_body_size 2100m)도 함께 올린다.
# JOB_PHOTOS_MAX_BYTES=2147483648
# 이보다 큰 작업 파일은 DB 가 아니라 FILESTORE_DIR/_jobs/ 에(32MB). 공용 폴더 없는 두 대(리허설)는
# JOB_PHOTOS_MAX_BYTES 이상으로 두어 전부 DB 에 — 그때는 사진 zip 상한도 512MB 쯤으로 낮춘다.
# JOB_FILE_INLINE_MAX_BYTES=33554432
# 작업이 **만드는** 결과 파일(내보내기)의 상한 — 올리는 파일과 따로다. 기록 200만 건 내보내기가
# zip 으로 128MB 였다. 만드는 동안 메모리에 들고 있으므로 그 아래로 둔다.
# JOB_OUTPUT_MAX_BYTES=536870912
# JOB_FILE_TTL_DAYS=7
# JOB_MAX_ROWS=100000
# 끝난 작업 **기록**을 지우기까지. 타이머가 소스마다 5분에 한 줄을 넣는다 — 안 지우면
# 사람이 올린 작업이 그 사이에 파묻힌다. 도는 것은 안 지운다.
# JOB_TTL_DAYS=30
# 이보다 오래 걸린 작업만 끝났을 때 알린다(짧게 끝난 것은 화면에서 봤다).
# JOB_NOTIFY_AFTER_SECONDS=20
# `running` 인데 이만큼 심장박동이 없으면 다른 워커가 되살린다. 짧게 잡으면 잠깐 느린
# 워커의 작업을 남이 뺏는다.
# WORKER_STALE_SECONDS=300
# WORKER_MAX_ATTEMPTS=3

# --- 보안 ---
# 기본값이면 앱이 기동을 거부한다(app/main.py). 그것이 의도다.
JWT_SECRET=REPLACE_WITH_RANDOM_48_CHAR_SECRET
# 로그인 유지 쿠키의 Secure — false 면 요청이 https 일 때만 붙는다(프록시 뒤는 TRUST_PROXY 가
# 판정). true 는 강제라 http 로 들어오면 새로고침마다 로그인 화면이 된다. 보통 false 로 둔다.
REFRESH_COOKIE_SECURE=false

# --- 데이터베이스 ---
# Apptainer 가 호스트 네트워크를 쓰므로 localhost 가 그대로 통한다.
DATABASE_URL=postgresql+psycopg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:5432/REPLACE_DB_NAME

# --- 컨테이너 안의 경로 ---
#
# **여기 안 적어도 된다.** 이미지가 자기 배치를 알고 있어서(apptainer.def 의
# %environment) LOG_DIR·FILESTORE_DIR 은 /data/logs · /data/filestore 로 온다.
#
# 적어서 바꾸려면 **systemd 유닛의 --bind 대상도 함께** 바꿔야 한다. 한쪽만
# 바꾸면 앱이 마운트 안 된 경로에 쓰게 되고, 기동 가드가 그것을 잡아 준다
# (무엇을 고쳐야 하는지 함께 말한다).
# LOG_DIR=/data/logs
# FILESTORE_DIR=/data/filestore

# --- 백업 ---
# 앱은 이 폴더의 마지막 덤프 시각만 읽어 홈의 「남은 일」 에 올린다. **컨테이너 안에서
# 보이는 경로**여야 한다 — deploy.sh 가 백업 폴더를 알면(공용 스토리지 DATA_DIR, 또는
# BACKUP_HOST_DIR) 유닛이 그것을 /data/backup 에 걸고 여기를 채운다. 안 적으면 「설정이 없다」 로 뜬다.
# BACKUP_DIR=/data/backup

# --- 프록시 뒤 · 경로 접두어 (이중화 · nginx) ---
# https://<호스트>/<slug>/ 로 서비스할 때 — nginx 가 접두어를 떼고 넘기고, 앱은 화면 · 쿠키 ·
# API 주소를 이 아래로 맞춘다. deploy.sh 가 이중화(HA_ROLE)면 채운다.
# PUBLIC_PATH=/<slug>
# X-Forwarded-For · X-Forwarded-Proto 를 믿는다 — 프록시 뒤에서만 true. 프록시 없이 켜면
# 아무나 그 헤더를 위조한다.
# TRUST_PROXY=false

# --- HWAX 포털에 붙이기 (ADR 0028 · 운영 안내서 「HWAX 포털에 붙이기」) ---
# 포털 nginx 가 https://<포털>/<id>/ 를 이 앱으로 넘긴다(접두어를 벗겨). 그때 위의 PUBLIC_PATH 는
# 포털의 id 와 같게(/<id> — 보통 /<slug>), TRUST_PROXY=true. 아래 값은 deploy.sh 에 env 로 주면
# 여기에 적힌다(`sudo PORTAL_JWKS_URL=… PORTAL_LAUNCH_URL=… ./deploy.sh update` — 준 것만).
#
# 포털의 공개 키 주소 — **비우면 포털 로그인이 꺼진다**(콜백이 404 JSON). 포털 담당에게 받는다:
# 사내망 http://<포털>:8088/.well-known/jwks.json 이 간단하다(https 면 사내 CA 를 이 서버가 믿어야 한다).
# PORTAL_JWKS_URL=
# 로그인 화면의 「HWAX 포털로 로그인」 이 가는 곳 — 포털의 /launch/<id>. 비우면 단추가 안 뜬다.
# PORTAL_LAUNCH_URL=https://hwax.sec.samsung.net/launch/<id>
# 토큰의 aud(포털 타일의 audience) — 비우면 APP_SLUG. 포털 id 를 slug 와 다르게 지었을 때만.
# PORTAL_AUDIENCE=
# 토큰의 iss(포털의 JWT_ISSUER) — 포털 기본값과 같으면 안 적는다.
# PORTAL_ISSUER=https://hwax.sec.samsung.net
# **포털은 MCP 경로를 열지 않는다**(Report Archive 와 같다) — 사람들의 Claude 는 포털 게이트웨이
# (https://hwax.sec.samsung.net/mcp-gw/mcp)로 붙고, 게이트웨이가 아래 위임으로 이 설치의 MCP 포트를 직접
# 부른다. 화면의 Claude 연결 안내(자기 토큰으로 직접 붙는 사람)가 닿는 주소를 보이게 MCP 포트 주소를 적는다
# — 비우면 화면이 https://<포털>/<id>/mcp 를 짐작하는데 그 길은 없다.
# MCP_PUBLIC_URL=http://<이 서버>:<MCP 포트>/mcp
#
# HWAX 게이트웨이의 사람별 위임(POST /api/auth/sso) — 게이트웨이가 사람마다 그 사람 명의의 개인 토큰(하루)을
# 받아 MCP 를 부른다. **비우면 꺼진다**(404). `sudo ./deploy.sh hwax-request` 가 없으면 만들어 여기 적는다
# (openssl rand -hex 32) — 포털 담당에게는 요청서와 **따로** 전한다(게이트웨이 provision.env 의 <접두>_SSO_SECRET).
# 이미 포털에 전한 값을 바꾸면 그 순간 위임이 전부 401 이다 — 바꿀 때는 포털 담당과 같이.
# HEAX_SSO_SECRET=
# 위임 발급을 받아 줄 원격 주소(쉼표 · CIDR, 포털 박스) — 비우면 비밀만 본다. TCP 원격 주소로만 판정하고,
# 목록이 있으면 X-Forwarded-For 가 붙은 요청은 받지 않는다(게이트웨이는 앱 포트로 직접 부른다).
# `sudo HEAX_SSO_ALLOWED_IPS=<주소> ./deploy.sh update` 로도 적는다.
# HEAX_SSO_ALLOWED_IPS=

# --- CORS ---
# 배포는 백엔드 한 프로세스가 SPA 까지 서빙하므로 같은 출처다 — 보통 비운다.
# CORS_ORIGINS=["https://app.example.com"]

# 데이터 소스가 파일(CSV·Excel·JSON)을 읽어도 되는 폴더. 비우면 URL 로만 읽는다.
# 이 폴더 아래만 읽는다 — 아무 경로나 읽게 두면 그 화면이 서버의 모든 파일을 읽는 문이 된다.
# 컨테이너 안 경로다: bind-mount 된 filestore 아래를 권장한다.
#DATASOURCE_DIR=/data/filestore/incoming

# --- 지표 (ADR 0013) ---
# 기록을 미리 세어 두는 표의 상한. 계획이 이보다 많은 셀을 어림하면 그 정의를 거절한다.
# METRICS_MAX_CELLS=2000000
# 지표 계산 트랜잭션의 work_mem — 200만 건을 묶을 때 기본값(4MB)이면 디스크로 넘어가 열 배 느리다.
# 계산은 한 번에 하나씩이라(지표마다 자문 잠금) 넉넉히 줘도 된다.
# METRICS_WORK_MEM=256MB
# 읽기 한 번이 받는 셀 상한 — 넘으면 응답이 `truncated` 로 말한다.
# METRICS_MAX_READ_CELLS=20000

# --- 느린 요청 · 큰 응답 (ADR 0026) ---
# 요청마다 걸린 시간 · 응답 크기를 남기고(조회 포함), 관리 › 서버 › 「느린 요청 · 큰 응답」 탭이 경로마다
# 묶어 보인다. 최근 24시간에 아래 문턱을 넘은 경로가 있으면 시스템 관리자의 홈 「남은 일」 에 뜬다 —
# 파일 응답(내려받기 · 사진)은 세지 않는다. p95 는 그 경로가 SLOW_REQUEST_MIN_CALLS 번 이상 불렸을 때만 본다.
# SLOW_REQUEST_P95_SECONDS=3
# SLOW_REQUEST_MIN_CALLS=5
# LARGE_RESPONSE_MB=5
# 목록 · 통계 · 추이 한 질의의 시간 상한(초, ADR 0031). 넘으면 끊고 504 「좁히거나 지표로」 — 그동안 DB 연결과
# 작업자가 묶이지 않게. 0 이면 안 건다. MCP 서버의 읽기 대기(90초)보다 짧게 둔다. 내보내기 · 지표 계산(작업)은 상관없다.
# READ_QUERY_SECONDS=60
# 같은 읽기에 그 요청에서만 거는 작업 메모리 · 병렬 작업자 수(ADR 0031). 정렬 · 해시 하나마다 · 작업자마다 잡히므로
# 동시 요청이 많으면 그 곱이다. 비우거나 -1 이면 서버 설정을 따른다. 서버 전체 설정은 `sudo ./deploy.sh pg-tune`.
# READ_WORK_MEM=64MB
# READ_PARALLEL_WORKERS=4
# 그 기록(request_timings)은 파일 로그와 같은 날수만 두고 워커가 한 시간마다 지운다.
# LOG_RETENTION_DAYS=30
# 접근 로그(누가 어느 통로로 무엇을 불렀나 — 보안 조사용)는 1년 두고 워커가 지운다. 0 이면 안 지운다.
# 감사 기록(변경 이력)은 이것과 상관없이 지우지 않는다.
# ACCESS_LOG_RETENTION_DAYS=365
