[Unit]
Description=@@APP_NAME@@ MCP Server (Claude integration)
After=network-online.target @@APP_SLUG@@.service
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@/mcp_server

# 백엔드(REST API)로 요청을 중계 — 사용자 토큰은 클라이언트가 보낸 헤더를 그대로 전달.
Environment=PLATFORM_API_BASE=@@API_BASE@@
Environment=MCP_HOST=@@MCP_HOST@@
Environment=MCP_PORT=@@MCP_PORT@@
# DNS rebinding 보호 허용 Host(쉼표구분). 비우면 server.py 가 비-localhost
# 바인딩 시 보호를 끈다. 외부 노출 시 도메인/IP 지정 권장.
Environment=MCP_ALLOWED_HOSTS=@@MCP_ALLOWED_HOSTS@@
# 이 MCP 가 무슨 플랫폼의 것인가 — 클라이언트에 보이는 서버 이름.
Environment=APP_SLUG=@@APP_SLUG@@
ExecStart=@@INSTALL_DIR@@/mcp_server/venv/bin/python @@INSTALL_DIR@@/mcp_server/server.py

Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# 가벼운 하드닝 (백엔드 유닛과 동일 기조). 설치 dir 가 /home 아래라 ProtectHome=false.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
