[Unit]
Description=@@APP_NAME@@ 데이터 소스 동기화 (차례가 된 것)
After=@@APP_SLUG@@.service
# 로컬 PostgreSQL 에 묶지 않는다 — 이중화에서는 DB 가 상대 서버에 있을 수 있다(app.service 참고).

[Service]
Type=oneshot
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@

# 웹 서비스와 **같은 SIF·같은 .env** 로 돈다 — 다른 파이썬으로 돌리면 그 둘이 다른
# 스키마를 볼 수 있다. 두 서버가 같은 시각에 돌아도 DB 의 자문 잠금이 한 대만 통과시킨다.
ExecStart=/usr/bin/apptainer exec \
    --bind @@ENV_FILE@@:/opt/app/backend/.env:ro \
    --bind @@FILESTORE_DIR@@:/data/filestore \
    --bind @@LOG_DIR@@:/data/logs \
@@BACKUP_BIND@@
    @@INSTALL_DIR@@/app.sif \
    sh -c 'cd /opt/app/backend && /opt/app/venv/bin/python scripts/sync_datasources.py --due'

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
