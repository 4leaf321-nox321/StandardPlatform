[Unit]
Description=@@APP_NAME@@ 지표 다시 계산 타이머

[Timer]
# **매시간** 「차례가 된 지표」 를 묻는다(`scripts/recompute_metrics.py --due`). 하루 미만 주기
# (6시간마다 …)는 그 시간이 지났으면 아무 때나, 「매일 밤 · N일마다 밤」 은 밤 시간(.env 의
# METRICS_NIGHT_HOUR, 기본 2시 — 서버 현지 시각)에만 센다. 02:30 은 백업(03:00)보다 앞 — 세어
# 둔 값까지 덤프에 든다. 셀 것이 없는 시간에는 목록만 보고 끝난다.
OnCalendar=*-*-* *:30
# 두 서버가 같은 초에 깨어 서로 잠금을 다투지 않게 조금 흩뜨린다.
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
