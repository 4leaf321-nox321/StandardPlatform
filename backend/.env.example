# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/standardplatform
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me

# 이 설치가 무슨 플랫폼인가 — 안 적으면 틀의 기본값(StandardPlatform · standardplatform).
# 개발에서는 확장을 전부 켜 두고 본다. Vite 개발 서버도 이 파일을 읽어 화면에 같은 값을 심는다.
# APP_SLUG=plmhub
# APP_NAME=PLM 기준정보
# APP_TAGLINE=
# EXTENSIONS=sample

# 목록 · 통계 읽기의 시간 상한과 그 요청에서만 거는 DB 설정(ADR 0031) — 운영과 같은 기본값이다. 개발 PC 의
# PostgreSQL 서버 설정(공유 버퍼 · 디스크 비용 …)은 `./deploy/pg-tune.sh --url "<DATABASE_URL>"` 로 보고 맞춘다.
# READ_QUERY_SECONDS=60
# READ_WORK_MEM=64MB
# READ_PARALLEL_WORKERS=4
# 임시 파일 상한 · 오래 도는 읽기(그래프의 그림 · 영향 범위)의 요청 시간 · 정적 그리기 동시 개수(ADR 0048). 임시 파일
# 상한은 DB 계정이 그 설정을 바꿀 수 있을 때만 걸린다(개발 PC 의 보통 계정은 못 한다 — 그러면 안 건다).
# READ_TEMP_LIMIT=5GB
# LONG_READ_SECONDS=120
# WHOLE_SLOTS=2
# 지식 그래프 「전체 지도」 자동 계산(ADR 0049) — false 면 워커가 지도 작업을 넣지 않는다(「전체 다시 배치」 는
# 시스템 관리자가 누를 때만). 기록이 상한을 넘으면 판을 계산하지 않고 거절한다. 지도 작업의 임시 파일 상한.
# GRAPH_MAP_AUTO=true
# GRAPH_MAP_MAX_RECORDS=50000000
# GRAPH_MAP_TEMP_LIMIT=20GB
# 밤 그래프 계산(ADR 0067) — 기대는 수 · 군집 · 비슷한 것 · 다리 역할. 엔진 auto 는 GPU 가 보이면 GPU(GPU 판 번들 ·
# 워커 --nv), gpu 로 박으면 못 쓸 때 실패한다. 스레드 0 은 코어 전부.
# GRAPH_CALC_NIGHT_HOUR=5
# GRAPH_CALC_AUTO=true
# GRAPH_CALC_ENGINE=auto
# GRAPH_CALC_THREADS=0
# 무리 · 다리 역할을 지을 선(쉼표로 — 관계 slug, 참조 칸은 <타입>.<칸>). 비우면 전부 — 전부면 공급사 중심, 구성만이면
# 제품군으로 묶인다. 모르는 이름이면 계산이 실패하고 아는 이름을 말한다.
# GRAPH_CALC_WHOLE_RELATIONS=
# 그래프 사본(4단계 — 설치마다 Neo4j 무료판, 127.0.0.1). deploy.sh 가 설치 때 적는다(포트는 앱 +3, 비밀번호는
# 난수). 비우면 사본이 없다 — Cypher 도구가 그렇다고 말한다. 질의 하나의 시간 · 줄 상한.
# GRAPHDB_URL=bolt://127.0.0.1:8003
# GRAPHDB_PASSWORD=
# GRAPHDB_QUERY_SECONDS=30
# GRAPHDB_ROWS=1000
# SPARQL 사본(ADR 0070 — 디스크에 세운 RDF 저장소, Oxigraph). deploy.sh 가 /data/rdfstore 로 적는다. 비우면 사본이
# 없다 — SPARQL 은 질의마다 메모리에 그래프를 세운다(객체 5만 개 상한). 질의 하나의 시간 · 메모리 상한, 바깥
# 창구(/api/rdf/sparql)의 줄 상한, 웹 프로세스 하나의 동시 질의 수.
# RDF_STORE_DIR=/data/rdfstore
# RDF_QUERY_SECONDS=60
# RDF_QUERY_MEMORY_MB=4096
# RDF_ROWS=10000
# RDF_CONCURRENCY=2
# 밤의 SPARQL 사본을 바뀐 것만 고친다(ADR 0071 — 지난 판의 지문과 견줘 바뀐 줄만). 끄면 밤마다 통째로. 켜도
# 정의 · SP 판이 바뀐 날 · 이 요일(mon ~ sun, 비우면 통째로 한 지 7일 지난 날) · 바뀐 것이 10% 넘는 날은 통째로.
# RDF_COPY_CHANGES=true
# RDF_COPY_FULL_WEEKDAY=sun
# 뜻으로 찾기의 임베딩 모델(ADR 0050) — Ollama 의 bge-m3. 개발 PC 는 Ollama 를 손으로 깐다(ollama pull bge-m3).
# pgvector 확장은 postgres 계정만 만든다 — 처음 한 번 sudo ./scripts/dev_pgvector.sh.
# EMBEDDING_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=bge-m3

# 첨부 한 파일의 상한(기본 500MB) — 넘는 업로드는 본문을 받기 전에 413.
# ATTACHMENT_MAX_BYTES=524288000

# 누가 무엇을 보나(ADR 0034) — all(기본): 부서와 상관없이 누구나 전부, department: 전역 + 내 부서만.
# 고치는 것은 어느 쪽이든 소유 부서의 관리자다.
# VIEW_SCOPE=all

# 사람이 여는 화면의 바탕 주소(접두어까지) — AI 의 답(MCP)에 붙는 화면 주소의 앞부분. 비우면 짐작한다
# (포털 로그인 주소 → MCP_PUBLIC_URL → MCP 가 들어온 주소). 개발에서는 보통 비운다.
# PUBLIC_URL=http://localhost:5210

# HWAX 포털로 로그인(ADR 0028) — 비우면 꺼진다(콜백이 404 JSON). 운영 값과 까닭은
# deploy/.env.production.example 의 「HWAX 포털에 붙이기」. Vite 개발 서버도 두 값을 보고 단추를 낸다.
# PORTAL_JWKS_URL=http://<포털>:8088/.well-known/jwks.json
# PORTAL_LAUNCH_URL=https://<포털>/launch/<id>
# HWAX 게이트웨이의 사람별 위임(POST /api/auth/sso) — 비우면 꺼진다(404). 개발에서 확인하려면 아무 긴 값.
# HEAX_SSO_SECRET=
# HEAX_SSO_ALLOWED_IPS=
